DATABASE_URL="postgresql://app:app@postgres:5432/my_master_api?schema=cuppcake"

APP_URL="https://cuppcake.my-crazy-master.ru"
AUTH_URL="https://cuppcake.my-crazy-master.ru"

JWT_ACCESS_SECRET="change-me-access-secret-min-32-chars-please"
JWT_REFRESH_SECRET="change-me-refresh-secret-min-32-chars-please"
JWT_ACCESS_TTL="15m"
JWT_REFRESH_TTL="7d"

AUTH_SECRET="change-me-authjs-secret-min-32-chars-please"

UPLOAD_DIR="public/uploads"
UPLOAD_MAX_FILE_SIZE_BYTES="10485760"

RUN_MIGRATIONS="1"
RUN_SEED="0"
